prices = 120, 45, 80, 15
total = sum of prices
show total
show sum of prices plus 1
halves = 0.5, 0.25, 0.125
show sum of halves
show_using_format "Total: <sum of prices>"
value at position 1 in prices becomes 0
show sum of prices
grand = 0
repeat 3 times:
    grand becomes grand plus sum of prices
end_of repeat
show grand
sum = 5
show sum
